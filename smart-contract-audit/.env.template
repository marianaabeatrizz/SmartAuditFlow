# Smart Contract Audit — multi-agent architecture
#
# Copy to .env and fill in. .env is gitignored; never commit it.
#
# ── WHAT YOU ACTUALLY NEED ───────────────────────────────────────────────
# At least TWO providers from DIFFERENT families. The judging panel refuses
# to let a model grade its own output, so with a single family there is no
# independent judge and benchmark runs will not start.
#
# All of the following have a free tier (see the course guide):
#   Gemini · Groq · Mistral · OpenRouter · Cloudflare Workers AI · Ollama
#
# Check your setup at any time:
#   .venv/Scripts/python.exe check_providers.py --probe

# ── Flask ────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=
PORT=5000
LOG_LEVEL=INFO

# ── Free tiers ───────────────────────────────────────────────────────────

# Google Gemini — aistudio.google.com/apikey  (family: google)
# Free tier outside UK/CH/EEA may be used by Google to improve products.
# Fine for the public benchmark contracts; do not send private code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM=15

# Groq — console.groq.com/keys  (family: groq)
# No logprobs; n must be 1; temperature=0 becomes 1e-8.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=30
GROQ_DAILY=1000

# Mistral — console.mistral.ai  (family: mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_RPM=30

# OpenRouter — openrouter.ai  (family: openrouter)
# OPENROUTER_MODEL is REQUIRED: the :free catalogue changes, so there is no
# safe default. Use the exact id, never an alias.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_RPM=20
OPENROUTER_DAILY=50

# Cloudflare Workers AI — dash.cloudflare.com  (family: cloudflare)
# Model ids are fixed and versioned, which is good for replication.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/openai/gpt-oss-20b

# Ollama, local — ollama.com/download  (family: ollama)
# Fully reproducible, no request limit. Uncomment once the daemon runs.
# OLLAMA_BASE_URL=http://localhost:11434/v1/
# OLLAMA_MODEL=qwen3:8b

# ── Paid ─────────────────────────────────────────────────────────────────

# DeepSeek — platform.deepseek.com  (family: deepseek)
# Cheapest off-peak (22:00–01:00 and 03:00–07:00 Recife time costs double).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI — platform.openai.com  (family: openai)
# The published baseline used GPT-4o, so this is the proposer for a
# like-for-like comparison.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — console.anthropic.com  (family: anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Any other OpenAI-compatible endpoint ─────────────────────────────────
# Declare it explicitly. Useful to run one vendor twice under two models —
# give them the same FAMILY so judge independence stays honest.
#
# SAF_PROVIDER_judge2_BASE_URL=https://api.groq.com/openai/v1
# SAF_PROVIDER_judge2_API_KEY=gsk_...
# SAF_PROVIDER_judge2_MODEL=llama-3.3-70b-versatile
# SAF_PROVIDER_judge2_FAMILY=groq
# SAF_PROVIDER_judge2_RPM=30

# ── Agent routing (optional) ─────────────────────────────────────────────
# Which provider each role uses. Defaults pick the best configured one.
# SAF_MODEL_ORCHESTRATOR=gemini
# SAF_MODEL_SPECIALIST=groq
# SAF_MODEL_VALIDATOR=mistral

# ── Response cache ───────────────────────────────────────────────────────
# On by default: debugging a prompt should not burn a daily quota.
# SAF_CACHE=0
# SAF_CACHE_DIR=.llm_cache
